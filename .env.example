# ---- data source ----
# Free key from https://finnhub.io (needed for --mode finnhub and real news)
FINNHUB_TOKEN=your_key_here
PRODUCER_MODE=simulate            # simulate | finnhub
SYMBOLS=AAPL,MSFT,NVDA,TSLA,BINANCE:BTCUSDT

# ---- local connections (docker compose overrides these inside containers) ----
KAFKA_BOOTSTRAP=localhost:9092
PG_DSN=dbname=stocks user=stocks password=stocks host=localhost port=5432
PG_RO_DSN=dbname=stocks user=analyst_ro password=analyst_ro host=localhost port=5432

# ---- GenAI assistant (any OpenAI-compatible provider; Groq has a free tier) ----
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant     # check your provider's current model list

# ---- optional cloud export ----
AWS_S3_BUCKET=
