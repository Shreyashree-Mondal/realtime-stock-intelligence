{
  "name": "stock-pipeline",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": { "memory": "8gb" },
  "postCreateCommand": "pip install -r requirements.txt -r requirements-dev.txt && cp -n .env.example .env",
  "forwardPorts": [8000, 8080, 4040, 5000, 8081],
  "portsAttributes": { "8000": { "label": "Dashboard", "onAutoForward": "openBrowser" } }
}